digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.5", ranksep="0.65", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=12];
edge [color="black", penwidth=0.75, fontname="Arial", fontsize=10, arrowsize=0.6];
DanhMuc [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="160" ALIGN="CENTER" BGCOLOR="black"><FONT COLOR="white"><B>DanhMuc</B></FONT></TD></TR><TR><TD WIDTH="160" PORT="MaDanhMuc" ALIGN="LEFT">MaDanhMuc (PK)</TD></TR><TR><TD WIDTH="160" PORT="TenDanhMuc" ALIGN="LEFT">TenDanhMuc (unique)</TD></TR><TR><TD WIDTH="160" PORT="MoTa" ALIGN="LEFT">MoTa (NULL)</TD></TR></TABLE>>];
