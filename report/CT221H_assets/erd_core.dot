{rank=same; DanhMuc;KhachHangDangNhap;LichSuGiaoDichVi;}
DanhMuc->KhachHangDangNhap [style=invis, weight=30];
KhachHangDangNhap->LichSuGiaoDichVi [style=invis, weight=30];
{rank=same; SanPham;KhachHang;DonHang;}
SanPham->KhachHang [style=invis, weight=30];
KhachHang->DonHang [style=invis, weight=30];
{rank=same; ChiTietGioHang;GioHang;ChiTietDonHang;}
ChiTietGioHang->GioHang [style=invis, weight=30];
GioHang->ChiTietDonHang [style=invis, weight=30];
DanhMuc->SanPham [xlabel="1 : 0..N", constraint=false];
SanPham:n->SanPham:n [xlabel="cha / loại", constraint=false];
KhachHang->KhachHangDangNhap [xlabel="1 : 0..1", constraint=false];
KhachHang->GioHang [xlabel="1 : 0..1", constraint=false];
GioHang->ChiTietGioHang [xlabel="1 : 0..N", constraint=false];
SanPham->ChiTietGioHang [xlabel="1 : 0..N", constraint=false];
KhachHang->DonHang [xlabel="1 : 0..N", constraint=false];
DonHang->ChiTietDonHang [xlabel="1 : 0..N", constraint=false];
SanPham->ChiTietDonHang [xlabel="1 : 0..N", constraint=false];
KhachHang->LichSuGiaoDichVi [xlabel="1 : 0..N", constraint=false];
DonHang->LichSuGiaoDichVi [xlabel="1 : 0..N", constraint=false];
DanhMuc->SanPham [style=invis, weight=50];
SanPham->ChiTietGioHang [style=invis, weight=50];
}