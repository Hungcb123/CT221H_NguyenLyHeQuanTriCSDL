KhachHang [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="160" ALIGN="CENTER" BGCOLOR="black"><FONT COLOR="white"><B>KhachHang</B></FONT></TD></TR><TR><TD WIDTH="160" PORT="MaKH" ALIGN="LEFT">MaKH (PK)</TD></TR><TR><TD WIDTH="160" PORT="HoTen" ALIGN="LEFT">HoTen</TD></TR><TR><TD WIDTH="160" PORT="Email" ALIGN="LEFT">Email (unique)</TD></TR><TR><TD WIDTH="160" PORT="SoDienThoai" ALIGN="LEFT">SoDienThoai (unique)</TD></TR><TR><TD WIDTH="160" PORT="DiaChi" ALIGN="LEFT">DiaChi (NULL)</TD></TR><TR><TD WIDTH="160" PORT="SoDuVi" ALIGN="LEFT">SoDuVi</TD></TR><TR><TD WIDTH="160" PORT="NgayTao" ALIGN="LEFT">NgayTao</TD></TR></TABLE>>];
GioHang [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD WIDTH="160" ALIGN="CENTER" BGCOLOR="black"><FONT COLOR="white"><B>GioHang</B></FONT></TD></TR><TR><TD WIDTH="160" PORT="MaGioHang" ALIGN="LEFT">MaGioHang (PK)</TD></TR><TR><TD WIDTH="160" PORT="MaKH" ALIGN="LEFT">MaKH (FK, unique)</TD></TR><TR><TD WIDTH="160" PORT="NgayCapNhat" ALIGN="LEFT">NgayCapNhat</TD></TR></TABLE>>];
